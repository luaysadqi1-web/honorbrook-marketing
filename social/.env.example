# Honorbrook social routine credentials.
# Copy to .env in this same folder and fill in. NEVER commit .env (gitignored).
#   cp .env.example .env

# --- X (Twitter) -----------------------------------------------------------
# developer.x.com -> your Project/App -> Keys and tokens.
# The App MUST be set to "Read and Write" BEFORE you generate the access token.
# If you flip permissions afterward, regenerate the token or posts return 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LinkedIn --------------------------------------------------------------
# Company page posting. Needs an app approved for the Community Management API
# with the w_organization_social scope, and the token's member must be an
# admin of the page. Token expires ~60 days - see SETUP-API-KEYS.md.
LINKEDIN_ACCESS_TOKEN=
# Numeric id from your page admin URL: linkedin.com/company/<id>/admin/
LINKEDIN_ORG_ID=

# --- Google Business Profile ----------------------------------------------
# Highest-value channel for local search. Requires an approved Business
# Profile API access request against your Google Cloud project.
# The refresh token does NOT expire (unlike LinkedIn) once the OAuth consent
# screen is Published rather than in Testing.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Bare numeric ids from accounts.list / accounts.locations.list
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
