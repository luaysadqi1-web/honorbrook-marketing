# Honorbrook social routine credentials.
# Copy to .env in this same folder and fill in. NEVER commit .env (gitignored).
#   cp .env.example .env

# --- X (Twitter) -----------------------------------------------------------
# developer.x.com -> your Project/App -> Keys and tokens.
# The App MUST be set to "Read and Write" BEFORE you generate the access token.
# If you flip permissions afterward, regenerate the token or posts return 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- LinkedIn --------------------------------------------------------------
# Company page posting. Needs an app approved for the Community Management API
# with the w_organization_social scope, and the token's member must be an
# admin of the page. Token expires ~60 days - see SETUP-API-KEYS.md.
LINKEDIN_ACCESS_TOKEN=
# Numeric id from your page admin URL: linkedin.com/company/<id>/admin/
LINKEDIN_ORG_ID=
# Optional but recommended. Without these the access token above dies after
# 60 days and LinkedIn goes dark until someone notices. With all three set,
# a 401 triggers one automatic refresh and the new token is written back here.
# Programmatic refresh tokens are only issued to approved apps.
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Google Business Profile ----------------------------------------------
# Highest-value channel for local search. Requires an approved Business
# Profile API access request against your Google Cloud project.
# The refresh token does NOT expire (unlike LinkedIn) once the OAuth consent
# screen is Published rather than in Testing.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Bare numeric ids from accounts.list / accounts.locations.list
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Meta (Facebook Page + Instagram) --------------------------------------
# Free, and no monthly post cap - this is what replaces Metricool for FB/IG.
# Facebook schedules natively (published=false + scheduled_publish_time, 10 min
# to 30 days out). Instagram has NO scheduling on the API at all, so IG items
# are published by run_daily.py at the moment they come due.
# Token needs pages_manage_posts + pages_read_engagement. Use a LONG-LIVED
# Page token; short-lived ones expire in about an hour.
META_PAGE_ID=520470514472094
META_PAGE_TOKEN=
# Instagram Business account id linked to the Page above (not the @handle).
META_IG_USER_ID=
