<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.honorbrook.social.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/luaysadqi/honorbrook-marketing/social/run_daily.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/luaysadqi/honorbrook-marketing/social</string>

  <!-- 9:15am local, every day -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <!-- If the Mac was asleep at 9:15, run once as soon as it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/luaysadqi/honorbrook-marketing/social/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/luaysadqi/honorbrook-marketing/social/logs/launchd.err.log</string>
</dict>
</plist>
